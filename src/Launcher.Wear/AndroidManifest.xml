<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-feature android:name="android.hardware.type.watch" android:required="true" />
  <uses-permission android:name="com.google.wear.permission.PUSH_WATCH_FACES" />
  <application android:label="Launcher for Wear OS" android:allowBackup="false">
    <meta-data android:name="com.google.android.wearable.standalone" android:value="false" />
    <service android:name="com.launcher.wear.FacePushService" android:exported="true">
      <intent-filter>
        <action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" />
        <data android:scheme="wear" android:host="*" android:pathPrefix="/launcher/watchface/v1/" />
      </intent-filter>
    </service>
  </application>
</manifest>
