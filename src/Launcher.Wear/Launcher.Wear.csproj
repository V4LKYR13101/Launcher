<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>34</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.launcher.home</ApplicationId>
    <ApplicationVersion>5</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.4</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Xamarin.GooglePlayServices.Wearable" Version="120.0.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Wear.WatchFace.Complications.Data.Source" Version="1.3.0.2" />
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.19.0.1" />
    <PackageReference Include="Xamarin.Google.Guava" Version="33.7.1" />
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.4.0.1" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Guava" Version="1.11.0.1" />
    <AndroidMavenLibrary Include="androidx.wear.watchfacepush:watchfacepush" Version="1.0.0" Repository="Google" Bind="false" />
    <AndroidJavaSource Include="FacePushService.java" />
  </ItemGroup>
</Project>
