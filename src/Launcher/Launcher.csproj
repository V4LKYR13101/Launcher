<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LauncherDistribution Condition="'$(LauncherDistribution)' == ''">Play</LauncherDistribution>
    <ApplicationId>com.kevlog.launcher</ApplicationId>
    <ApplicationId Condition="'$(LauncherDistribution)' == 'Kevlog'">com.launcher.home</ApplicationId>
    <ApplicationVersion>50</ApplicationVersion>
    <ApplicationDisplayVersion>2.0.5</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <!--
      Enables trim analyzers and full trimming during Release mode.
      To learn more, see: https://learn.microsoft.com/dotnet/core/deploying/trimming/trimming-options#trimming-granularity
    -->
    <TrimMode>partial</TrimMode>
    <AndroidPackageFormats>aab</AndroidPackageFormats>
    <AndroidPackageFormats Condition="'$(LauncherDistribution)' == 'Kevlog'">apk</AndroidPackageFormats>
    <AndroidManifest Condition="'$(LauncherDistribution)' == 'Play'">AndroidManifest.Play.xml</AndroidManifest>
    <DefineConstants Condition="'$(LauncherDistribution)' == 'Play'">$(DefineConstants);LAUNCHER_PLAY</DefineConstants>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <ItemGroup>
    <TransformFile Include="Java/DiscoverBindings.xml" />
    <AndroidJavaSource Include="Java/com/google/android/libraries/launcherclient/*.java" Bind="true" />
    <AndroidJavaSource Include="Java/com/kevlog/launcher/discover/DiscoverClient.java" Bind="true" />
    <Compile Include="../Launcher.Wear/AccentData.cs" Link="Services/AccentData.cs" />
    <Compile Include="../Launcher.Wear/RollSync.cs" Link="Services/RollSync.cs" />
    <ProjectReference Include="../Launcher.Core/Launcher.Core.csproj" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="Xamarin.GooglePlayServices.Wearable" Version="120.0.1.1" />
  </ItemGroup>
    <ItemGroup>
        <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
        <!-- Use the ONNX Runtime native binaries already packaged by sherpa-onnx. -->
        <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.27.1" />
        <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.1" ExcludeAssets="all" />
        <PackageReference Include="SentenceTransformers.EmbeddingGemma2" Version="26.10.6453" />
        <PackageReference Include="MessagePack" Version="3.1.9" />
        <PackageReference Include="PdfPig" Version="0.1.16" />
        <PackageReference Include="SharpCompress" Version="0.50.10" />
    </ItemGroup>
  <ItemGroup Condition="'$(LauncherDistribution)' == 'Play'">
    <Compile Remove="Services/UpdateProvider.cs" />
  </ItemGroup>
  <Target Name="ValidateLauncherDistribution" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(LauncherDistribution)' != 'Play' And '$(LauncherDistribution)' != 'Kevlog'" Text="LauncherDistribution must be Play or Kevlog." />
  </Target>
  <Target Name="RequireProductionSigning" BeforeTargets="SignAndroidPackage" Condition="'$(LauncherProductionRelease)' == 'true'">
    <Error Condition="'$(AndroidKeyStore)' != 'true'" Text="A production release requires an explicit dedicated signing key. Use tools/Build-LauncherRelease.ps1 for the legacy-key migration packages." />
  </Target>
</Project>
